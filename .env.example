# Modelo de variáveis do painel. Para Render, use os valores/observações do README.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
COOKIE_SECURE=false
# O Render fornece PORT, usa HOST=0.0.0.0 e COOKIE_SECURE=true automaticamente.
SESSION_SECRET=
# Firebase Realtime Database usado pelo painel; token só se as regras exigirem.
FIREBASE_DATABASE_URL=https://gerador-goldxits-default-rtdb.firebaseio.com
FIREBASE_DATABASE_PATH=proxyAndroid/keys
# Opcional e privado; não use aqui a chave privada da conta de serviço do Worker.
FIREBASE_AUTH_TOKEN=
# Senha privada de acesso configurada na hospedagem; não envie este arquivo preenchido.
OWNER_PASSWORD=
# BotaPix: os dois primeiros campos são secretos; configure somente na hospedagem.
BOTAPIX_API_KEY=
BOTAPIX_WEBHOOK_SECRET=
# URL base HTTPS do painel, sem barra final; usada no retorno/webhook do pagamento.
PUBLIC_URL=
# URL da API BotaPix; o servidor usa esse padrão se a variável ficar vazia.
BOTAPIX_API_BASE=https://botapix.com/api/v1
