# Servidor local do painel
HOST=127.0.0.1
PORT=3000
COOKIE_SECURE=false
# Firebase Realtime Database indicado no app.js de referência
FIREBASE_DATABASE_URL=https://gerador-goldxits-default-rtdb.firebaseio.com
FIREBASE_DATABASE_PATH=proxyAndroid/keys
# Opcional: token/credencial Firebase; mantenha privado se as regras exigirem.
FIREBASE_AUTH_TOKEN=
# Senha-mestra opcional do dono; o servidor grava somente o hash em data/owner-auth.json.
# Nunca preencha este valor em arquivo enviado ao GitHub.
OWNER_PASSWORD=
# SESSION_SECRET é criado automaticamente em data/session-secret se não for informado.
